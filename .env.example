# Market-data provider selection: finnhub or twelvedata
MARKET_DATA_PROVIDER="finnhub"

# Provider credentials. Configure the key for the selected provider.
FINNHUB_API_KEY="your_finnhub_api_key"
TWELVE_DATA_API_KEY="your_twelve_data_api_key"

# Required. The server refuses to start without this value.
BACKEND_API_KEY="replace_with_a_long_random_secret"

# Server controls
PORT=4000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_CONCURRENT=4

# Frontend build/runtime configuration. Empty uses same-origin /api requests.
VITE_BACKEND_URL=""

# Optional AI features
GEMINI_API_KEY="your_gemini_api_key"
APP_URL="http://localhost:3000"
